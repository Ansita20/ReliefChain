# Copy this file to `.env` and fill in your own values.
# `.env` is listed in .gitignore and must NEVER be committed.

# HTTPS RPC endpoint for Sepolia (a free public one: https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=

# Private key of a TEST wallet funded with Sepolia ETH. Never use a wallet holding real funds.
PRIVATE_KEY=

# Optional: lets you verify the contract source on Etherscan
ETHERSCAN_API_KEY=

# Optional (Sepolia seed only): comma-separated addresses to approve as extra demo agencies
DEMO_AGENCY_ADDRESSES=
