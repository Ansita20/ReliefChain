# Optional frontend settings. Copy to `.env.local` to override.

# Which network the app reads from before a wallet is connected:
# 31337 = local Hardhat node, 11155111 = Sepolia
VITE_DEFAULT_CHAIN_ID=31337

# RPC endpoints used for READ-ONLY calls (dashboard, eligibility checks).
# Writes always go through MetaMask.
# (default for local: <this site>/rpc, which the Vite server forwards to http://127.0.0.1:8545)
# VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
