# Frontend settings. Copy to `.env.local` to override.

# ---- Hosted build (Vercel / Sepolia) ----
# Set these on the hosting provider. When VITE_CHAIN_ID is set the app runs on that chain ONLY
# and ignores the local Hardhat entry in src/contracts/deployments.json.
# Leave them empty for local Hardhat development.

# Chain to pin the app to. Sepolia = 11155111.
VITE_CHAIN_ID=
# ReliefRegistry address on that chain.
VITE_CONTRACT_ADDRESS=
# Block the contract was deployed in (event history is read from here).
VITE_DEPLOY_BLOCK=
# Read-only JSON-RPC endpoint, e.g. https://ethereum-sepolia-rpc.publicnode.com
VITE_RPC_URL=

# ---- Local development (used only when VITE_CHAIN_ID is empty) ----
# Which network the app reads from before a wallet is connected:
# 31337 = local Hardhat node, 11155111 = Sepolia
VITE_DEFAULT_CHAIN_ID=31337

# RPC endpoints used for READ-ONLY calls (dashboard, eligibility checks).
# Writes always go through MetaMask.
# (default for local: <this site>/rpc, which the Vite server forwards to http://127.0.0.1:8545)
# VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
